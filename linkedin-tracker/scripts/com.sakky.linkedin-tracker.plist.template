<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sakky.linkedin-tracker</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE_PATH__</string>
        <string>__TRACKER_DIR__/build/check-new-post.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__TRACKER_DIR__</string>

    <!-- Post-detection schedule (local time): every 15 minutes, every day,
         08:47 through 17:02 — 34 slots on the :47/:02/:17/:32 grid. launchd has
         no "every N minutes between X and Y", so the grid is spelled out.
         No Weekday key = all 7 days.

         The job itself keeps this from being 34 LinkedIn loads a day: each slot
         adds a random 0–4 min delay, skips LinkedIn once DAILY_POST_CAP posts
         have been found today, and stops for the day after a login/challenge
         page (see src/check-new-post.ts). launchd never starts a second copy
         while one is still running, so a slow slot simply swallows the next. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>47</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>2</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>32</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>47</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>2</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>32</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>47</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>2</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>32</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>47</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>2</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>32</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>47</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>2</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>32</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>47</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>2</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>32</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>47</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>2</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>32</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>47</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>2</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>32</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>47</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>2</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>__TRACKER_DIR__/logs/tracker.out.log</string>

    <key>StandardErrorPath</key>
    <string>__TRACKER_DIR__/logs/tracker.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
