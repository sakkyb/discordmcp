        <string>__TRACKER_DIR__/build/check-new-post.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__TRACKER_DIR__</string>

    <!-- Post-detection schedule (local time):
         Mon-Fri morning  09:00 + retries 09:30, 10:00
         Mon-Fri evening  18:00 + retries 18:30, 19:00   (catches evening posts same day)
         Sat              10:30 + retries 11:00, 11:30
         Sun              17:30 + retries 18:00, 18:30
         Retry slots no-op automatically once the day's post is found. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
