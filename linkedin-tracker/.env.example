# Your public LinkedIn profile URL (no trailing slash)
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-slug

# Notion integration token (can be the same one the Discord bot uses)
NOTION_TOKEN=

# Notion database_id for the table the tracker syncs to (reuses "Content schedule").
# NOTE: this is the database_id (the hex segment in the DB URL), NOT a data_source_id.
# The table must have: Post name (title), Post URL (url), Date (date), and number
#   columns Reactions, Comments, Reposts, Impressions, Profile views,
#   Followers gained, Saves, Sends.
# To use different column names, edit the PROP map in src/lib/notion.ts.
NOTION_LINKEDIN_DATABASE_ID=

# Discord: new posts are announced by the bot in a channel, tagging a user.
# DISCORD_TOKEN is the same bot token the Discord MCP bot uses (repo-root .env).
# Channel and mention default in code to "LinkedIn Maxxing" #content-posted and
# adi.lami; set these only to override.
DISCORD_TOKEN=
# DISCORD_CHANNEL_ID=1456684379408695351
# DISCORD_MENTION_USER_ID=541101599368675329
# Channel for failure alerts (e.g. WhatsApp send failed); defaults to #error-messages
# DISCORD_ALERT_CHANNEL_ID=1537381914543915048

# Optional extra channel: also post new-post announcements to this WhatsApp group
# via the macOS WhatsApp app. Requires the Mac logged in with WhatsApp running
# and parked on that chat, and Accessibility + Automation granted to the node
# binary in the launchd plist (see scripts/wa-send.applescript).
# Leave empty to disable (Discord stays the primary notification).
# WHATSAPP_WEB_GROUP_NAME=LinkedIn Maxxing

# Optional. Used to match a live post to its planned "Content schedule" row by
# reading the post's content instead of guessing from the date. Copy the value
# from the repo-root .env. Without it the tracker falls back to date matching,
# which mis-assigns rows when several posts share a day or a plan slips.
ANTHROPIC_API_KEY=

# Set to 'true' to run Chrome headless (default: headed, which looks more
# like normal browsing to LinkedIn)
HEADLESS=false

# python3 used for the OCR chat-header check before each WhatsApp send. Must
# have pyobjc installed:
#   pip3 install pyobjc-framework-Vision pyobjc-framework-Quartz
# Absolute, because launchd runs with a minimal PATH where `python3` is
# /usr/bin/python3 (no pyobjc).
# PYTHON_BIN=/usr/local/bin/python3

# Set to 'true' to send WITHOUT verifying which chat is open. Removes the need
# for a Screen Recording grant, at the cost of the only safeguard against
# posting to the wrong chat.
# WHATSAPP_SKIP_CHAT_VERIFY=false

# Absolute path to the portfolio-20k repo, whose /linkedin-preview page renders
# the phone mock that the evening job screenshots. The job serves it locally for
# a few seconds per run (next start if a production build exists, otherwise
# next dev) and stops it again.
PORTFOLIO_20K_DIR=/Users/sakshatbaral/Projects/life-master/portfolio-20k

# Port that temporary preview server listens on. Fixed rather than random so a
# stale process is easy to spot.
# PREVIEW_PORT=4321

# Channel for the evening "here's tomorrow's post" preview; defaults to
# "LinkedIn Maxxing" #content-upcoming.
# DISCORD_PREVIEW_CHANNEL_ID=1541343781155115038

# LinkedIn has no page or public API for scheduled posts, so the evening job
# calls the same internal GraphQL query the composer modal uses. This queryId is
# version-stamped and WILL rotate when LinkedIn ships a new frontend; when it
# does the job fails loudly with an HTTP 400/404. To re-capture: in normal Chrome
# open the scheduled-posts list, DevTools > Network, filter "graphql", and copy
# the queryId from the request whose x-li-pem-metadata mentions LoadSchedulePost.
# LINKEDIN_SCHEDULED_QUERY_ID=voyagerContentcreationDashSharePreviews.bcae3f9b4dca29d5c589c05485dad181
