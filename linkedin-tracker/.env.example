# Your public LinkedIn profile URL (no trailing slash)
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-slug

# Notion integration token (can be the same one the Discord bot uses)
NOTION_TOKEN=

# Notion database_id for the table the tracker syncs to (reuses "Content schedule").
# NOTE: this is the database_id (the hex segment in the DB URL), NOT a data_source_id.
# The table must have: Post name (title), Post URL (url), Date (date),
#   Reactions (number), Comments (number), Reposts (number).
# To use different column names, edit the PROP map in src/lib/notion.ts.
NOTION_LINKEDIN_DATABASE_ID=

# Exact name of the WhatsApp group to notify (leave empty to disable WhatsApp).
# Run 'npm run login:whatsapp' to see the list of available group names.
WHATSAPP_GROUP_NAME=

# Set to 'true' to run Chrome headless (default: headed, which looks more
# like normal browsing to LinkedIn)
HEADLESS=false

# Optional: path to the Chrome binary WhatsApp (puppeteer) should drive.
# Defaults to the system Google Chrome, a universal binary that runs natively
# on arm64. Only set this if Chrome lives somewhere non-standard.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
