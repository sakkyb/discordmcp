# ntfy.sh topic to publish to. Subscribe to it in the ntfy app. Anyone who
# knows the name can read it, so keep it unguessable.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Weekday slots count from this time; weekends count all day.
# EVENING_START=17:00

# Runs outside this window exit immediately (Europe/London).
# ACTIVE_HOURS=07:00-23:00

# ClubSpark's booking window: guests book up to HORIZON_DAYS ahead, and the
# furthest day opens at RELEASE_TIME on the day it comes into range. Check
# https://clubspark.lta.org.uk/v0/VenueBooking/<segment>/GetSettings
# (Roles[].AdvancedBookingPeriod, NewDayBookingAvailabilityTime in minutes).
# HORIZON_DAYS=7
# RELEASE_TIME=20:00

# Ignore contiguous free time shorter than this (minutes). Two touching
# 30-minute sessions count as 60.
# MIN_SLOT_MINUTES=60

# Unlit courts (Burgess Park court 7) are skipped. true = include them.
# INCLUDE_UNLIT=false

# Comma-separated ClubSpark segments to watch (default: all three).
# VENUES=BurgessParkSouthwark,kenningtonpark,GeraldineMaryHarmsworth

# true = fetch and print what would be sent; no ntfy, no state write
# DRY_RUN=false
