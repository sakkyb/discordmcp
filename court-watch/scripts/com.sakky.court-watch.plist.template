<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sakky.court-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE_PATH__</string>
        <string>__PKG_DIR__/build/check-courts.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PKG_DIR__</string>

    <!-- Every 10 minutes. The script itself exits at once outside ACTIVE_HOURS. -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__PKG_DIR__/logs/court-watch.out.log</string>

    <key>StandardErrorPath</key>
    <string>__PKG_DIR__/logs/court-watch.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
