# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Anthropic API key for Claude
ANTHROPIC_API_KEY=

# Optional: enables the web_search tool
BRAVE_API_KEY=

# Optional: enables saving LinkedIn posts to a Notion database
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Optional: port for the local /health endpoint (defaults to 3000)
PORT=3000
