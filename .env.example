# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Anthropic API key for Claude
ANTHROPIC_API_KEY=

# Optional: enables the web_search tool
BRAVE_API_KEY=

# Optional: enables saving LinkedIn posts to the Notion "Content schedule".
# NOTION_DATA_SOURCE_ID is the data source id (not the database id) — required
# for multi-source databases on Notion API version 2025-09-03.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=

# Optional: port for the local /health endpoint (defaults to 3000)
PORT=3000
