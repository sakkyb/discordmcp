# Discord bot token (same as repo-root .env)
DISCORD_TOKEN=

# Notion integration token (same as linkedin-tracker/.env)
NOTION_TOKEN=

# Data source of the "Content schedule" database (LinkedIn page), whose
# "content ideas" view shows the weekly page. Same value as NOTION_DATA_SOURCE_ID
# in the repo-root .env. Title/date columns of that table:
# NOTION_CONTENT_IDEAS_DATA_SOURCE_ID=27801c06-49d0-80e9-af9e-000b48703100
# NOTION_TITLE_PROPERTY=Post name
# NOTION_DATE_PROPERTY=Date

# Discord channels (LinkedIn Maxxing server). Defaults in code.
# DISCORD_CHANNEL_ID=1548630846737490041        # #twitter-weekly-bangers
# DISCORD_ALERT_CHANNEL_ID=1537381914543915048  # #errors-sakky

# Anthropic API key for the relevance classifier (same key as repo-root .env)
ANTHROPIC_API_KEY=
# CLASSIFY=true                    # false = skip Claude, report the raw top list
# CLASSIFIER_MODEL=claude-sonnet-5
# MIN_SCORE=3                      # 1..5, see rubric.md

# Search tuning
# MIN_FAVES=50000
# MAX_POSTS=100
# REPORT_COUNT=50
# LOOKBACK_DAYS=7

# Headed Chrome looks like normal browsing; keep it unless you know why not.
# HEADLESS=false

# true = search and print the report, no Discord/Notion/state writes
# DRY_RUN=false
