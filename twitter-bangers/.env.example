# Discord bot token (same as repo-root .env)
DISCORD_TOKEN=

# Notion integration token (same as linkedin-tracker/.env)
NOTION_TOKEN=

# Data source inside the "Content Master Table" (LinkedIn page) whose
# "content ideas" view you use. Defaults to the first source; switch to
# 3a301c06-49d0-8026-aca1-000bbd95c126 if the weekly page does not show up
# in that view.
# NOTION_CONTENT_IDEAS_DATA_SOURCE_ID=27e01c06-49d0-808b-b355-000b53e20a3f

# Discord channels (LinkedIn Maxxing server). Defaults in code.
# DISCORD_CHANNEL_ID=1548630846737490041        # #twitter-weekly-bangers
# DISCORD_ALERT_CHANNEL_ID=1537381914543915048  # #errors-sakky

# Search tuning
# MIN_FAVES=50000
# MAX_POSTS=100
# REPORT_COUNT=20
# LOOKBACK_DAYS=7

# Headed Chrome looks like normal browsing; keep it unless you know why not.
# HEADLESS=false

# true = search and print the report, no Discord/Notion/state writes
# DRY_RUN=false
